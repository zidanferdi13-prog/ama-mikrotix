# Contoh konfigurasi. Salin ke .env dan isi nilai sebenarnya.
# Jangan pernah commit .env atau nilai rahasia ke Git/chat/log.

# --- Database (dipakai collector + server) ---
AMA_DB_HOST=127.0.0.1
AMA_DB_PORT=3306
AMA_DB_USER=ama_app
AMA_DB_PASSWORD=
AMA_DB_NAME=ama_monitoring
AMA_DB_POOL=5

# --- Server REST + Socket.IO ---
AMA_PORT=3001
AMA_WEB_ORIGIN=http://localhost:5173

# --- Auth dashboard (ganti sebelum dipakai) ---
AMA_AUTH_USER=operator
AMA_AUTH_PASSWORD=
AMA_JWT_SECRET=
AMA_JWT_TTL=8h
# Set 'true' hanya bila di belakang HTTPS.
AMA_COOKIE_SECURE=false

# --- Inventaris aset ICT (opsional) ---
# GET API inventaris; kosong = nama aset/pemilik tidak ditampilkan. Daftar (~200 KB)
# di-cache 5 menit di memori proses.
AMA_ASSET_API_URL=https://services.ama.id/employee/dashboardAssetIct

# --- Collector ---
# Daftar perangkat diambil dari tabel `devices` (dikelola dari halaman Perangkat
# di dashboard). Tidak ada lagi berkas konfigurasi perangkat di repo.
AMA_DEVICE_REFRESH_MS=15000
# Berkas rahasia JSON { "1": "password", "2": "..." } di luar repo, mode 600.
# Ditulis oleh server saat password diisi dari dashboard; boleh juga disunting manual.
AMA_SECRETS_FILE=/etc/ama/secrets.json

# Alternatif rahasia per perangkat lewat env (ID = kolom devices.id):
# AMA_DEVICE_1_PASSWORD=
# AMA_DEVICE_2_PASSWORD=
# AMA_DEVICE_3_PASSWORD=

# --- Kontrol AP (reboot) ---
# Set true untuk mengizinkan aksi kontrol (reboot) dari dashboard.
AMA_CONTROL_ENABLED=false

# --- Diagnosa AI (opsional) ---
# Tanpa API key: tombol Diagnosa tetap jalan (rule-based), tanpa ringkasan AI.
# Format OpenAI-compatible. Contoh base URL:
#   OpenAI    https://api.openai.com/v1                                  (model gpt-4o-mini)
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai    (model gemini-2.0-flash)
#   Anthropic https://api.anthropic.com/v1                               (model claude-3-5-haiku-latest)
# Yang dikirim: temuan + angka metrik. MAC, IP client, nama aset, pemilik di-redaksi.
AMA_AI_BASE_URL=https://api.openai.com/v1
AMA_AI_API_KEY=
AMA_AI_MODEL=gpt-4o-mini
